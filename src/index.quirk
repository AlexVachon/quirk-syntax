---
Syntax highlighting, a line at a time.

A `Language` splits one line into `Token`s (start, end, kind) and says what
the next line starts inside — a docstring, a triple-quoted string — so an
editor colours a file line by line and, after an edit, only from that line
on until the states agree again (`Highlighter`).

Kinds: "keyword", "constant", "type", "function", "string", "escape",
"interpolation", "number", "comment", "doc", "operator", "punctuation",
"decorator", "plain". A `Theme` gives each a colour ("#rrggbb").

@example
use syntax

lang := syntax.for_file("main.qk")
hl := syntax.Highlighter(lang)
lines := ["define main() -> void {", "    print(\"hi\")  // greet", "}"]
for t in hl.tokens(lines, 1) {
    tok: syntax.Token = t
    print(tok.kind, String(lines[1]).substring(tok.start, tok.end))
}
---
from typing.primitives.string use { String }
from typing.collections.list use { List }
from typing.collections.map use { Map }

// What a line starts inside (Language.tokenize's `state`).
const CODE: Int = 0
const DOC: Int = 1             // a --- docstring ---
const TRIPLE2: Int = 2         // """ ... """
const TRIPLE1: Int = 3         // ''' ... '''
const RAW_TRIPLE2: Int = 4     // r""" ... """
const RAW_TRIPLE1: Int = 5     // r''' ... '''

--- Characters [start, end) of a line, of one `kind`. ---
struct Token {
    start: Int
    end: Int
    kind: String

    define __init(self, start: Int, end: Int, kind: String) -> void {
        self.start = start
        self.end = end
        self.kind = kind
    }

    define __str(self) -> String {
        return self.kind + "[" + String(self.start) + ", " + String(self.end) + ")"
    }
}

--- A line's tokens, and the state the next line starts in. ---
struct LineTokens {
    tokens: List
    state: Int

    define __init(self, tokens: List, state: Int) -> void {
        self.tokens = tokens
        self.state = state
    }
}

---
How a language is coloured: `tokenize(line, state)` — `state` is what the
line starts inside (0: plain code). The base one makes the whole line
"plain"; subclass it for another language.
---
struct Language {
    name: String

    define __init(self, name: String) -> void {
        self.name = name
    }

    define tokenize(self, line: String, state: Int) -> LineTokens {
        if line.length() == 0 { return LineTokens([], state) }
        return LineTokens([Token(0, line.length(), "plain")], state)
    }

    --- What starts a line comment ("" for none): editors use it to comment lines out. ---
    define line_comment(self) -> String {
        return ""
    }
}

// ===== Quirk =====

_quirk_keywords := {"define": true, "struct": true, "super": true, "use": true, "from": true, "extend": true,
                    "init": true, "extern": true, "return": true, "if": true, "else": true, "elif": true,
                    "and": true, "or": true, "not": true, "while": true, "for": true, "in": true, "with": true,
                    "as": true, "del": true, "is": true, "try": true, "catch": true, "throw": true,
                    "finally": true, "break": true, "continue": true, "enum": true, "match": true,
                    "case": true, "fn": true, "where": true, "const": true, "type": true, "nonlocal": true,
                    "global": true, "interface": true, "async": true, "await": true, "self": true}
_quirk_constants := {"true": true, "false": true, "null": true}

--- Quirk: keywords, types, strings (raw, triple-quoted, `${}` interpolation), // comments, --- docstrings ---. ---
struct QuirkLanguage : Language {
    define __init(self) -> void {
        super().__init("Quirk")
    }

    define line_comment(self) -> String {
        return "//"
    }

    define tokenize(self, line: String, state: Int) -> LineTokens {
        out := []
        n := line.length()
        i := 0
        st := state
        // Inside something from the line before: carry on until it closes.
        if st == DOC {
            close := line.find("---")
            if close < 0 {
                if n > 0 { out.append(Token(0, n, "doc")) }
                return LineTokens(out, DOC)
            }
            out.append(Token(0, close + 3, "doc"))
            i = close + 3
            st = CODE
        } elif st != CODE {
            quote := (st == TRIPLE1 or st == RAW_TRIPLE1) ? "'" : "\""
            raw := st == RAW_TRIPLE2 or st == RAW_TRIPLE1
            end := _string_body(line, 0, quote, true, raw, out)
            if end < 0 { return LineTokens(out, st) }
            i = end
            st = CODE
        }
        last_word := ""
        while i < n {
            c := line[i]
            if c == " " or c == "\t" {
                i = i + 1
                continue
            }
            if c == "/" and i + 1 < n and line[i + 1] == "/" {
                out.append(Token(i, n, "comment"))
                return LineTokens(out, CODE)
            }
            if c == "-" and _at(line, i, "---") {
                close := line.find("---", i + 3)
                if close < 0 {
                    out.append(Token(i, n, "doc"))
                    return LineTokens(out, DOC)
                }
                out.append(Token(i, close + 3, "doc"))
                i = close + 3
                continue
            }
            raw := false
            q := i
            if (c == "r") and i + 1 < n and (line[i + 1] == "\"" or line[i + 1] == "'") and not _word_char_before(line, i) {
                raw = true
                q = i + 1
            }
            if line[q] == "\"" or line[q] == "'" {
                quote := line[q]
                triple := _at(line, q, quote + quote + quote)
                body := q + (triple ? 3 : 1)
                out.append(Token(i, body, "string"))
                end := _string_body(line, body, quote, triple, raw, out)
                if end < 0 {
                    if not triple { return LineTokens(out, CODE) }   // (unterminated: to the end of the line)
                    if quote == "'" { return LineTokens(out, raw ? RAW_TRIPLE1 : TRIPLE1) }
                    return LineTokens(out, raw ? RAW_TRIPLE2 : TRIPLE2)
                }
                i = end
                last_word = ""
                continue
            }
            if _is_digit(c) {
                j := i + 1
                while j < n and (_is_word(line[j]) or (line[j] == "." and j + 1 < n and _is_digit(line[j + 1]))) { j = j + 1 }
                out.append(Token(i, j, "number"))
                i = j
                continue
            }
            if _is_word_start(c) {
                j := i + 1
                while j < n and _is_word(line[j]) { j = j + 1 }
                word := line.substring(i, j)
                kind := "plain"
                if _quirk_constants.has(word) {
                    kind = "constant"
                } elif _quirk_keywords.has(word) {
                    kind = "keyword"
                } elif last_word == "define" or last_word == "fn" {
                    kind = "function"
                } elif _next_char(line, j) == "(" {
                    kind = _is_upper(c) ? "type" : "function"
                } elif _is_upper(c) {
                    kind = "type"
                }
                out.append(Token(i, j, kind))
                last_word = word
                i = j
                continue
            }
            if c == "@" {
                j := i + 1
                while j < n and _is_word(line[j]) { j = j + 1 }
                out.append(Token(i, j, "decorator"))
                i = j
                continue
            }
            if "()[]{},;".contains(c) {
                out.append(Token(i, i + 1, "punctuation"))
                i = i + 1
                continue
            }
            j := i + 1
            while j < n and "+-*/%=<>!&|^~?:.".contains(line[j]) and not (line[j] == "/" and j + 1 < n and line[j + 1] == "/") { j = j + 1 }
            out.append(Token(i, j, "operator"))
            i = j
        }
        return LineTokens(out, st)
    }
}

// From `start`, the inside of a string closed by `quote` (three of them when
// `triple`): its pieces appended to `out` ("string", and unless `raw`,
// "escape" for \x and "interpolation" for ${...} / $name). Where it ends
// (after the closing quote), or -1 when the line ends first.
define _string_body(line: String, start: Int, quote: String, triple: Bool, raw: Bool, out: List) -> Int {
    n := line.length()
    i := start
    seg := start
    close := triple ? quote + quote + quote : quote
    while i < n {
        if _at(line, i, close) {
            out.append(Token(seg, i + close.length(), "string"))
            return i + close.length()
        }
        c := line[i]
        if not raw and c == "\\" and i + 1 < n {
            if i > seg { out.append(Token(seg, i, "string")) }
            out.append(Token(i, i + 2, "escape"))
            i = i + 2
            seg = i
            continue
        }
        if not raw and c == "$" and i + 1 < n and (line[i + 1] == "{" or _is_word_start(line[i + 1])) {
            if i > seg { out.append(Token(seg, i, "string")) }
            j := i + 1
            if line[j] == "{" {
                depth := 0
                while j < n {
                    if line[j] == "{" { depth = depth + 1 }
                    if line[j] == "}" {
                        depth = depth - 1
                        if depth == 0 {
                            j = j + 1
                            break
                        }
                    }
                    j = j + 1
                }
            } else {
                while j < n and _is_word(line[j]) { j = j + 1 }
            }
            out.append(Token(i, j, "interpolation"))
            i = j
            seg = i
            continue
        }
        i = i + 1
    }
    if n > seg { out.append(Token(seg, n, "string")) }
    return -1
}

define _at(line: String, i: Int, s: String) -> Bool {
    if i + s.length() > line.length() { return false }
    return line.substring(i, i + s.length()) == s
}

define _is_digit(c: String) -> Bool {
    return c >= "0" and c <= "9"
}

define _is_upper(c: String) -> Bool {
    return c >= "A" and c <= "Z"
}

define _is_word_start(c: String) -> Bool {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
}

define _is_word(c: String) -> Bool {
    return _is_word_start(c) or _is_digit(c)
}

define _word_char_before(line: String, i: Int) -> Bool {
    return i > 0 and _is_word(line[i - 1])
}

// The next character after `j` that isn't a space ("" at the end).
define _next_char(line: String, j: Int) -> String {
    k := j
    while k < line.length() and line[k] == " " { k = k + 1 }
    return k < line.length() ? line[k] : ""
}

--- Quirk's language. ---
define quirk() -> Language {
    return QuirkLanguage()
}

--- No colours: every line one "plain" token. ---
define plain() -> Language {
    return Language("Plain text")
}

--- The language for a file, by its extension (.qk / .quirk: Quirk; else plain text). ---
define for_file(path: String) -> Language {
    if path.endswith(".qk") or path.endswith(".quirk") { return quirk() }
    return plain()
}

// ===== Highlighter =====

---
A file's tokens, line by line, kept between edits. `tokens(lines, i)` gives
line `i`'s (working out the lines above it the first time); after an edit,
`changed(first_line)` — what's above stays, what's below is redone when
it's asked for, and stops being redone where the line states agree again.
---
struct Highlighter {
    lang: Language
    _starts: List        // the state each line starts in (as far as known)
    _cache: List         // LineTokens per line (null: not worked out)

    define __init(self, lang: Language) -> void {
        self.lang = lang
        self._starts = [CODE]
        self._cache = []
    }

    --- Line `i`'s tokens (`lines`: the file's lines, as Strings). ---
    define tokens(self, lines: List, i: Int) -> List {
        if i < 0 or i >= lines.length() { return [] }
        self._fill(lines, i)
        lt: LineTokens = self._cache[i]
        return lt.tokens
    }

    --- The state line `i` starts in. ---
    define state_at(self, lines: List, i: Int) -> Int {
        if i <= 0 { return CODE }
        self._fill(lines, i - 1)
        return Int(self._starts[i])
    }

    --- Lines from `first` on changed (typed into, inserted, removed): forget them. ---
    define changed(self, first: Int) -> void {
        f := first < 0 ? 0 : first
        while self._cache.length() > f { self._cache.pop() }
        while self._starts.length() > f + 1 { self._starts.pop() }
    }

    --- Everything changed (another file, another language). ---
    define reset(self) -> void {
        self._starts = [CODE]
        self._cache = []
    }

    define _fill(self, lines: List, upto: Int) -> void {
        i := self._cache.length()
        while i <= upto {
            line: String = lines[i]
            st := Int(self._starts[i])
            lt := self.lang.tokenize(line, st)
            self._cache.append(lt)
            if self._starts.length() == i + 1 { self._starts.append(lt.state) } else { self._starts[i + 1] = lt.state }
            i = i + 1
        }
    }
}

// ===== themes =====

---
A colour ("#rrggbb") for each token kind, and the editor's own colours:
"background", "text", "gutter", "gutter_text", "line" (the current
line), "selection", "cursor". `color(kind)` falls back to "text".
---
struct Theme {
    name: String
    colors: Map

    define __init(self, name: String, colors: Map) -> void {
        self.name = name
        self.colors = colors
    }

    define color(self, kind: String) -> String {
        if self.colors.has(kind) { return String(self.colors[kind]) }
        if self.colors.has("text") { return String(self.colors["text"]) }
        return "#cccccc"
    }
}

--- Dark: light text on near-black (like VS Code's "Dark Modern"). ---
define dark() -> Theme {
    return Theme("Dark", {
        "background": "#1f1f1f", "text": "#cccccc", "gutter": "#1f1f1f", "gutter_text": "#6e7681",
        "gutter_current": "#cccccc", "line": "#2a2a2a", "selection": "#264f78", "cursor": "#aeafad",
        "keyword": "#c586c0", "constant": "#569cd6", "type": "#4ec9b0", "function": "#dcdcaa",
        "string": "#ce9178", "escape": "#d7ba7d", "interpolation": "#9cdcfe", "number": "#b5cea8",
        "comment": "#6a9955", "doc": "#6a9955", "operator": "#d4d4d4", "punctuation": "#cccccc",
        "decorator": "#dcdcaa", "plain": "#9cdcfe"
    })
}

--- Light: dark text on white. ---
define light() -> Theme {
    return Theme("Light", {
        "background": "#ffffff", "text": "#3b3b3b", "gutter": "#ffffff", "gutter_text": "#8a8a8a",
        "gutter_current": "#171184", "line": "#f3f3f3", "selection": "#add6ff", "cursor": "#000000",
        "keyword": "#af00db", "constant": "#0000ff", "type": "#267f99", "function": "#795e26",
        "string": "#a31515", "escape": "#ee0000", "interpolation": "#001080", "number": "#098658",
        "comment": "#008000", "doc": "#008000", "operator": "#3b3b3b", "punctuation": "#3b3b3b",
        "decorator": "#795e26", "plain": "#001080"
    })
}
