use syntax
use test

// A line's tokens as "kind:text" pieces (spaces between tokens aren't tokens).
define show(lang: syntax.Language, line: String, state: Int = 0) -> String {
    lt := lang.tokenize(line, state)
    parts := []
    for t in lt.tokens {
        tok: syntax.Token = t
        parts.append(tok.kind + ":" + line.substring(tok.start, tok.end))
    }
    return " ".join(parts)
}

define test_keywords_names_numbers() -> void {
    q := syntax.quirk()
    test.assert_eq(show(q, "define add(a: Int, b: Int) -> Int {"),
        "keyword:define function:add punctuation:( plain:a operator:: type:Int punctuation:, plain:b operator:: type:Int punctuation:) operator:-> type:Int punctuation:{")
    test.assert_eq(show(q, "    return a + b * 2.5"), "keyword:return plain:a operator:+ plain:b operator:* number:2.5")
    test.assert_eq(show(q, "x := true and not null"), "plain:x operator::= constant:true keyword:and keyword:not constant:null")
    test.assert_eq(show(q, "p := Point(1, 2)"), "plain:p operator::= type:Point punctuation:( number:1 punctuation:, number:2 punctuation:)")
    test.assert_eq(show(q, "db.query_as(Todo, sql)"), "plain:db operator:. function:query_as punctuation:( type:Todo punctuation:, plain:sql punctuation:)")
    test.assert_eq(show(q, "@cache"), "decorator:@cache")
    test.assert_eq(show(q, "for item in items {"), "keyword:for plain:item keyword:in plain:items punctuation:{")
}

define test_strings_and_comments() -> void {
    q := syntax.quirk()
    test.assert_eq(show(q, "s := \"a\\tb\" // note"), "plain:s operator::= string:\" string:a escape:\\t string:b\" comment:// note")
    test.assert_eq(show(q, "\"hi \${name}!\""), "string:\" string:hi  interpolation:\${name} string:!\"")
    test.assert_eq(show(q, "\"\$who here\""), "string:\" interpolation:\$who string: here\"")
    test.assert_eq(show(q, "r\"\\d+ \$x\""), "string:r\" string:\\d+ \$x\"")          // raw: no escapes, no \$
    test.assert_eq(show(q, "'c' + x / 2"), "string:' string:c' operator:+ plain:x operator:/ number:2")
    test.assert_eq(show(q, "url := \"http://x\""), "plain:url operator::= string:\" string:http://x\"")   // not a comment
    test.assert_eq(show(q, "\"open"), "string:\" string:open")                     // unterminated: to the end
}

define test_states_across_lines() -> void {
    q := syntax.quirk()
    a := q.tokenize("t := \"\"\"first", 0)
    test.assert_eq(a.state, syntax.TRIPLE2)
    test.assert_eq(show(q, "middle \${x}", syntax.TRIPLE2), "string:middle  interpolation:\${x}")
    b := q.tokenize("last\"\"\" + y", syntax.TRIPLE2)
    test.assert_eq(b.state, 0)
    test.assert_eq(show(q, "last\"\"\" + y", syntax.TRIPLE2), "string:last\"\"\" operator:+ plain:y")
    test.assert_eq(q.tokenize("return r\"\"\"<p>{{ x }}", 0).state, syntax.RAW_TRIPLE2)
    test.assert_eq(show(q, "<b>\$no</b>", syntax.RAW_TRIPLE2), "string:<b>\$no</b>")   // raw: \$ isn't interpolation
    test.assert_eq(q.tokenize("---", 0).state, syntax.DOC)
    test.assert_eq(show(q, "A doc line, with \"quotes\"", syntax.DOC), "doc:A doc line, with \"quotes\"")
    test.assert_eq(q.tokenize("---", syntax.DOC).state, 0)
    test.assert_eq(show(q, "--- One line. ---"), "doc:--- One line. ---")
    test.assert_eq(show(q, "x := 1 - --y"), "plain:x operator::= number:1 operator:- operator:-- plain:y")
}

define test_highlighter_redoes_only_what_changed() -> void {
    lines := ["x := 1", "s := \"\"\"", "still string", "\"\"\"", "y := 2"]
    hl := syntax.Highlighter(syntax.quirk())
    t2: syntax.Token = hl.tokens(lines, 2)[0]
    test.assert_eq(t2.kind, "string")
    t4: syntax.Token = hl.tokens(lines, 4)[0]
    test.assert_eq(t4.kind, "plain")
    // Close the string earlier: line 2 is code now.
    lines[1] = "s := \"\"\"\"\"\""
    hl.changed(1)
    t2b: syntax.Token = hl.tokens(lines, 2)[0]
    test.assert_eq(t2b.kind, "plain")
    test.assert_eq(hl.state_at(lines, 3), 0)
    test.assert_eq(hl.tokens(lines, 99).length(), 0)
}

define test_languages_and_themes() -> void {
    test.assert_eq(syntax.for_file("src/main.qk").name, "Quirk")
    test.assert_eq(syntax.for_file("lib.quirk").line_comment(), "//")
    p := syntax.for_file("notes.txt")
    test.assert_eq(p.name, "Plain text")
    test.assert_eq(show(p, "anything at all"), "plain:anything at all")
    d := syntax.dark()
    test.assert_eq(d.color("keyword"), "#c586c0")
    test.assert_eq(d.color("no-such-kind"), d.color("text"))
    test.assert_eq(syntax.light().color("background"), "#ffffff")
}

_PY := "name = \"Python\"\n" +
       "extensions = [\".py\", \".pyi\"]\n" +
       "line_comment = \"#\"\n" +
       "keywords = \"def class  if\"\n" +
       "constants = \"True False None\"\n" +
       "[[rule]]\nkind = \"comment\"\nmatch = '#.*'\n" +
       "[[rule]]\nkind = \"string\"\nbegin = '\"\"\"'\nend = '\"\"\"'\n" +
       "[server]\ncommand = [\"pyright-langserver\", \"--stdio\"]\n"

define test_parse_config() -> void {
    c := syntax.parse_config(_PY)
    test.assert_eq(c.name, "Python")
    test.assert_eq(c.extensions.length(), 2)
    test.assert_eq(c.line_comment, "#")
    test.assert_true(c.keywords.has("def"))
    test.assert_false(c.keywords.has("True"))      // a constant, not a keyword
    test.assert_false(c.keywords.has(""))          // the double space
    test.assert_eq(c.keywords.length(), 3)
    test.assert_eq(c.rules.length(), 2)
    r: syntax.Rule = c.rules[1]
    test.assert_eq(r.kind, "string")
    test.assert_eq(r.begin, "\"\"\"")
    test.assert_eq(String(c.server[0]), "pyright-langserver")
}

define test_parse_config_defaults() -> void {
    c := syntax.parse_config("name = \"X\"\n")
    test.assert_eq(c.name, "X")
    test.assert_eq(c.extensions.length(), 0)
    test.assert_eq(c.rules.length(), 0)
    test.assert_eq(c.server.length(), 0)
    test.assert_eq(c.keywords.length(), 0)
}

// Like show(), plus " | <state the next line starts in>".
define show_state(lang: syntax.Language, line: String, state: Int = 0) -> String {
    lt := lang.tokenize(line, state)
    return show(lang, line, state) + " | " + String(lt.state)
}

_PY_RULES := "name = \"Python\"\n" +
       "line_comment = \"#\"\n" +
       "keywords = \"def return if\"\n" +
       "constants = \"True None\"\n" +
       "types = \"int\"\n" +
       "[[rule]]\nkind = \"comment\"\nmatch = '#.*'\n" +
       "[[rule]]\nkind = \"string\"\nbegin = '\"\"\"'\nend = '\"\"\"'\n" +
       "[[rule]]\nkind = \"string\"\nmatch = '\"([^\"\\\\]|\\\\.)*\"'\n" +
       "[[rule]]\nkind = \"number\"\nmatch = '[0-9][0-9_.]*'\n"

define test_rules_words_and_punctuation() -> void {
    py := syntax.RuleLanguage(syntax.parse_config(_PY_RULES))
    test.assert_eq(py.name, "Python")
    test.assert_eq(py.line_comment(), "#")
    test.assert_eq(show_state(py, "def add(a: int) -> None:"),
        "keyword:def function:add punctuation:( plain:a operator:: type:int punctuation:) operator:- operator:> constant:None operator:: | 0")
    test.assert_eq(show_state(py, "    return 42  # the answer"), "keyword:return number:42 comment:# the answer | 0")
    test.assert_eq(show_state(py, "x1 = 2"), "plain:x1 operator:= number:2 | 0")
}

define test_first_rule_to_start_wins() -> void {
    py := syntax.RuleLanguage(syntax.parse_config(_PY_RULES))
    test.assert_eq(show_state(py, "x = \"a # not a comment\" # one"), "plain:x operator:= string:\"a # not a comment\" comment:# one | 0")
    test.assert_eq(show_state(py, "s = \"say \\\"hi\\\"\""), "plain:s operator:= string:\"say \\\"hi\\\"\" | 0")
}

define test_begin_end_across_lines() -> void {
    py := syntax.RuleLanguage(syntax.parse_config(_PY_RULES))
    test.assert_eq(show_state(py, "doc = \"\"\"start"), "plain:doc operator:= string:\"\"\"start | 2")
    test.assert_eq(show_state(py, "middle # not a comment", 2), "string:middle # not a comment | 2")
    test.assert_eq(show_state(py, "end\"\"\" + 1", 2), "string:end\"\"\" operator:+ number:1 | 0")
    test.assert_eq(show_state(py, "x = \"\"\"one line\"\"\""), "plain:x operator:= string:\"\"\"one line\"\"\" | 0")
}

define test_highlighter_with_rules() -> void {
    hl := syntax.Highlighter(syntax.RuleLanguage(syntax.parse_config(_PY_RULES)))
    lines := ["a = \"\"\"", "inside", "\"\"\"", "b = 1"]
    last: syntax.Token = hl.tokens(lines, 3)[2]
    test.assert_eq(last.kind, "number")
    inside: syntax.Token = hl.tokens(lines, 1)[0]
    test.assert_eq(inside.kind, "string")
}